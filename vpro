# ───────────────────────────────────────────────────────────────────────────────
# COUCHE 2 : LE MOTEUR D'ESSAIM (SWARM ENGINE)
# ───────────────────────────────────────────────────────────────────────────────

class SwarmGeniusOmega:
    def __init__(self):
        self.memory = []
        self.active_tokens = {}
        self.lock = threading.Lock()

    def _generate_hash(self, content):
        """Génère un hash de vérification pour chaque pensée."""
        return hashlib.sha256(content.encode()).hexdigest()[:16]

    def _think(self, genius, prompt):
        """
        Simule la réflexion d'un génie sur le prompt.
        Dans une vraie implémentation, cela appellerait une API LLM (GPT-4, Claude).
        Ici, on génère une pensée structurée basée sur le profil.
        """
        time.sleep(random.uniform(0.1, 0.4))  # Simulation du temps de calcul
        
        thought = (
            f"[{genius.name} | {genius.domain}]\n"
            f"Stratégie: {genius.strategy}\n"
            f"Analyse: En appliquant {genius.cognitive_bias}, je vois que le prompt "
            f"'{prompt}' nécessite une approche basée sur {genius.strategy.lower()}.\n"
            f"Conclusion partielle: {uuid.uuid4().hex[:8]} (Séquence logique validée)."
        )
        return {"genius": genius.name, "thought": thought, "confidence": random.uniform(0.7, 0.99)}

    def _synthesize(self, results, prompt):
        """
        Le Consensus : Fusionne les pensées des 20 génies pour créer une méta-réponse.
        """
        # Trier par confiance
        sorted_results = sorted(results, key=lambda x: x['confidence'], reverse=True)
        top_geniuses = sorted_results[:5] # On garde le top 5 pour la synthèse finale
        
        synthesis = (
            f"═══ RÉSONANCE COGNITIVE OMEGA ═══\n"
            f"Prompt initial : {prompt}\n\n"
            f"Après délibération de {len(results)} agents cognitifs, voici la synthèse :\n\n"
        )
        
        for i, res in enumerate(top_geniuses, 1):
            synthesis += f"{i}. Contribution de {res['genius']} (Confiance: {res['confidence']*100:.1f}%)\n"
        
        synthesis += (
            f"\n→ Méta-Conclusion : La solution optimale émerge de la fusion "
            f"des perspectives de {top_geniuses[0]['genius']} et {top_geniuses[1]['genius']}.\n"
        )
        
        return synthesis

    def execute_resonance(self, utilisateur, contexte, prompt):
        """
        Processus principal : Génère un token, lance l'essaim, scelle le résultat.
        """
        start_time = time.time()
        
        # 1. Génération du Token
        raw_token = f"{utilisateur}{contexte}{time.time()}"
        token_hash = self._generate_hash(raw_token)
        
        with self.lock:
            self.active_tokens[token_hash] = utilisateur
            self.memory.append({
                "type": "token_creation",
                "hash": token_hash,
                "timestamp": datetime.now().isoformat()
            })

        print(f"🔑 Token de résonance généré : {token_hash}")
        print(f"🧠 Déploiement de l'essaim ({len(GENIUS_SWARM)} génies) pour le prompt : '{prompt}'...\n")

        # 2. Exécution parallèle de l'essaim
        results = []
        with ThreadPoolExecutor(max_workers=len(GENIUS_SWARM)) as executor:
            futures = {executor.submit(self._think, g, prompt): g for g in GENIUS_SWARM}
            
            for future in as_completed(futures):
                res = future.result()
                results.append(res)
                # Affichage en temps réel
                print(f"  [{res['genius']}] a fini de réfléchir. (Confiance: {res['confidence']*100:.1f}%)")

        # 3. Synthèse
        final_synthesis = self._synthesize(results, prompt)
        
        # 4. Scellement cryptographique
        synthesis_hash = self._generate_hash(final_synthesis)
        
        # 5. Sauvegarde mémoire
        with self.lock:
            self.memory.append({
                "type": "resonance_result",
                "token": token_hash,
                "prompt": prompt,
                "synthesis_hash": synthesis_hash,
                "timestamp": datetime.now().isoformat()
            })

        duration = time.time() - start_time
        
        return {
            "token": token_hash,
            "synthesis_hash": synthesis_hash,
            "result": final_synthesis,
            "duration_sec": round(duration, 2),
            "agents_used": len(results)
        }

    def rapport(self):
        return {
            "tokens_actifs": len(self.active_tokens),
            "memoire_totale": len(self.memory)
        }

